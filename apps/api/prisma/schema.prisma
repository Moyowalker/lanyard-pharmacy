generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  draft
  pending_review
  awaiting_payment
  processing
  ready_for_dispatch
  in_transit
  delivered
  cancelled
}

enum PrescriptionStatus {
  submitted
  under_review
  approved
  fulfilled
  rejected
  clarification_requested
}

enum PaymentProvider {
  paystack
  flutterwave
}

enum PaymentAttemptStatus {
  initiated
  authorized
  captured
  failed
  refunded
}

enum DeliveryDispatchMode {
  manual_dispatch
  courier_dispatch
}

enum DeliveryStatus {
  assigned
  in_transit
  delivered
  cancelled
}

enum WorkflowEventStatus {
  pending
  processing
  retrying
  completed
  failed
  dead_lettered
}

enum NotificationChannel {
  email
  sms
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
}

model Branch {
  id               String           @id @db.VarChar(64)
  name             String
  city             String
  supportsDelivery Boolean          @default(true)
  branchProducts   BranchProduct[]
  inventoryBatches InventoryBatch[]
  lowStockAlerts   LowStockAlert[]
  pharmacyOrders   PharmacyOrder[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("branches")
}

model Customer {
  id                 String          @id @db.VarChar(64)
  firstName          String
  lastName           String
  email              String          @unique
  phone              String          @unique
  refillReminderOptIn Boolean        @default(false)
  pharmacyOrders     PharmacyOrder[]
  prescriptions      Prescription[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("customers")
}

model PlatformUser {
  id           String   @id @db.VarChar(64)
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  roles        String[] @default([])
  branchIds    String[] @default([]) @map("branch_ids")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_users")
}

model Product {
  id                   String           @id @db.VarChar(64)
  name                 String
  slug                 String           @unique
  requiresPrescription Boolean          @default(false)
  category             String
  dosageForm           String
  price                Int
  branchProducts       BranchProduct[]
  inventoryBatches     InventoryBatch[]
  lowStockAlerts       LowStockAlert[]
  orderItems           OrderItem[]
  inventoryReservations InventoryReservation[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("products")
}

model BranchProduct {
  branchId  String   @db.VarChar(64)
  productId String   @db.VarChar(64)
  lowStockThreshold Int @default(5)
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  @@index([productId])
  @@map("branch_products")
}

model InventoryBatch {
  id                String   @id @db.VarChar(64)
  branchId          String   @db.VarChar(64)
  productId         String   @db.VarChar(64)
  availableQuantity Int
  reservedQuantity  Int      @default(0)
  batchCode         String
  expiryDate        DateTime @db.Date
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservations      InventoryReservation[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([branchId, batchCode])
  @@index([branchId, productId])
  @@map("inventory_batches")
}

model LowStockAlert {
  id                String   @id @db.VarChar(64)
  branchId          String   @db.VarChar(64)
  productId         String   @db.VarChar(64)
  threshold         Int
  availableQuantity Int
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("low_stock_alerts")
}

model PharmacyOrder {
  id                        String           @id @db.VarChar(64)
  customerId                String           @db.VarChar(64)
  branchId                  String           @db.VarChar(64)
  status                    OrderStatus
  total                     Int
  containsPrescriptionItems Boolean          @default(false)
  customer                  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch                    Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items                     OrderItem[]
  inventoryReservations     InventoryReservation[]
  prescriptions             Prescription[]
  paymentAttempts           PaymentAttempt[]
  deliveryJob               DeliveryJob?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([customerId])
  @@index([branchId])
  @@map("orders")
}

model OrderItem {
  id        String        @id @db.VarChar(64)
  orderId    String        @db.VarChar(64)
  productId  String        @db.VarChar(64)
  quantity   Int
  unitPrice  Int
  order      PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([orderId])
  @@index([productId])
  @@unique([orderId, productId])
  @@map("order_items")
}

model InventoryReservation {
  id               String         @id @db.VarChar(64)
  orderId          String         @db.VarChar(64)
  inventoryBatchId String         @db.VarChar(64)
  productId        String         @db.VarChar(64)
  quantity         Int
  order            PharmacyOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([inventoryBatchId])
  @@index([productId])
  @@unique([orderId, inventoryBatchId, productId])
  @@map("inventory_reservations")
}

model Prescription {
  id         String             @id @db.VarChar(64)
  customerId String             @db.VarChar(64)
  orderId    String?            @db.VarChar(64)
  status     PrescriptionStatus
  reviewedBy String?            @db.VarChar(64)
  uploadedAt DateTime
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order      PharmacyOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@map("prescriptions")
}

model PaymentAttempt {
  id                String               @id @db.VarChar(64)
  orderId           String               @db.VarChar(64)
  provider          PaymentProvider
  status            PaymentAttemptStatus
  providerReference String               @unique
  amount            Int
  currency          String               @default("NGN")
  order             PharmacyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([orderId])
  @@map("payment_attempts")
}

model DeliveryJob {
  id                String               @id @db.VarChar(64)
  orderId           String               @unique @db.VarChar(64)
  dispatchMode      DeliveryDispatchMode
  status            DeliveryStatus
  assignedTo        String               @db.VarChar(128)
  assignedBy        String               @db.VarChar(64)
  trackingReference String?              @db.VarChar(128)
  order             PharmacyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("delivery_jobs")
}

model WorkflowEvent {
  id                   String                       @id @db.VarChar(64)
  eventType            String                       @db.VarChar(128)
  entityType           String                       @db.VarChar(64)
  entityId             String                       @db.VarChar(128)
  status               WorkflowEventStatus         @default(pending)
  attempts             Int                          @default(0)
  maxAttempts          Int                          @default(3)
  payload              Json
  errorMessage         String?                      @db.VarChar(512)
  notificationAttempts NotificationDeliveryAttempt[]
  availableAt          DateTime                     @default(now())
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  lastAttemptedAt      DateTime?
  processedAt          DateTime?
  deadLetteredAt       DateTime?

  @@index([status, availableAt, createdAt])
  @@index([entityType, entityId])
  @@map("workflow_events")
}

model NotificationDeliveryAttempt {
  id             String                     @id @db.VarChar(64)
  workflowEventId String                    @db.VarChar(64)
  channel        NotificationChannel
  recipient      String                     @db.VarChar(255)
  template       String                     @db.VarChar(128)
  provider       String                     @db.VarChar(64)
  status         NotificationDeliveryStatus @default(queued)
  payload        Json
  errorMessage   String?                    @db.VarChar(512)
  workflowEvent  WorkflowEvent              @relation(fields: [workflowEventId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  sentAt         DateTime?

  @@index([workflowEventId])
  @@index([status, createdAt])
  @@map("notification_delivery_attempts")
}

model AuditEvent {
  id         String   @id @db.VarChar(64)
  actorId    String?  @db.VarChar(64)
  actorEmail String?  @db.VarChar(255)
  entityType String   @db.VarChar(64)
  entityId   String   @db.VarChar(128)
  action     String   @db.VarChar(64)
  payload    Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}